{
  "name": "kayzen",
  "version": "1.0.0",
  "private": true,
  "description": "Kayzen (کایزن) — offline-first Persian productivity planner. Next.js PWA shipped to Google Play as a Trusted Web Activity.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "contrast": "node scripts/check-contrast.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "assetlinks:generate": "node scripts/generate-assetlinks.mjs",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs",
    "twa:init": "bubblewrap init --manifest=\"$NEXT_PUBLIC_APP_URL/manifest.json\" --directory=android/twa",
    "twa:build": "bubblewrap build --directory=android/twa --skipPwaValidation",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-visually-hidden": "1.1.1",
    "@sentry/nextjs": "8.47.0",
    "@tanstack/react-query": "5.62.11",
    "@tanstack/react-query-devtools": "5.62.11",
    "@upstash/ratelimit": "2.0.5",
    "@upstash/redis": "1.34.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "date-fns-jalali": "4.1.0-0",
    "dompurify": "3.2.3",
    "framer-motion": "11.15.0",
    "howler": "2.2.4",
    "jose": "5.9.6",
    "lucide-react": "0.469.0",
    "marked": "15.0.4",
    "next": "15.1.3",
    "pino": "9.5.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@playwright/test": "1.49.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/howler": "2.2.12",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.3",
    "eslint-config-prettier": "9.1.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "prisma": "6.2.1",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
