// Kayzen — data model.
//
// Every tenant-owned table carries a `user_id` column that the Postgres RLS
// policies in `supabase/migrations/0002_row_level_security.sql` match against
// `app.current_user_id()`. The application never queries those tables outside
// `withUserContext()` (see `src/lib/db/rls.ts`), which sets that GUC inside the
// transaction that runs the query.
//
// The two pre-authentication tables — `otp_sessions` and `refresh_tokens` — are
// the documented exception: the caller has no identity yet when they are read.
// Neither stores a usable secret (both keep digests only).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK

  @@map("theme_preference")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ARCHIVED

  @@map("task_status")
}

enum TaskDifficulty {
  TRIVIAL
  EASY
  MEDIUM
  HARD
  EPIC

  @@map("task_difficulty")
}

enum FinancialBoxCategory {
  SAVINGS
  TRAVEL
  EDUCATION
  GADGET
  EMERGENCY
  DEBT
  GIFT
  OTHER

  @@map("financial_box_category")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL

  @@map("transaction_type")
}

enum PomodoroMode {
  FOCUS
  SHORT_BREAK
  LONG_BREAK

  @@map("pomodoro_mode")
}

/// The five languages the daily vocabulary module delivers.
enum LearningLanguage {
  ENGLISH
  TURKISH
  FRENCH
  GERMAN
  SPANISH
}

/// Three tiers, named for the user in Persian as راحت / متوسط / سخت.
enum LearningLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Where a word stands for one learner. `LEARNING` is the default the day it
/// is delivered; `MASTERED` is what the vault lists.
enum VocabularyStatus {
  LEARNING
  REVIEWING
  MASTERED
}

/// What a notification is about. Each one is a switch the user owns, which is
/// why this is an enum rather than a free string: a category nobody can turn
/// off is a category that will eventually be turned off by uninstalling.
/**
 * Which half of the Reading Hub a person is using.
 * Not a per-book setting: it is the question "what does reading mean to me
 * right now", and somebody who is 200 pages into a novel does not want the
 * daily micro-summary competing for the same fifteen minutes.
 */
enum ReadingMode {
  /// The curated 365-day micro-summary curriculum.
  SUMMARY
  /// A book of the person's own, tracked by pages.
  FULL_BOOK

  @@map("reading_mode")
}

enum NotificationCategory {
  TASK_REMINDER
  HABIT_PROMPT
  VOCABULARY
  READING
  FINANCIAL_MILESTONE
  SYSTEM
}

enum OtpPurpose {
  SIGN_IN
  PHONE_CHANGE

  @@map("otp_purpose")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                String          @id @default(uuid()) @db.Uuid
  /// E.164, always `+98…` for Iranian numbers. The only login identifier.
  phone             String          @unique @db.VarChar(16)
  phoneVerifiedAt   DateTime?       @map("phone_verified_at") @db.Timestamptz(6)
  /// scrypt hash of the account password; null when sign-in is SMS-only.
  /// Never leaves the server: no DTO carries it and no route returns it.
  passwordHash      String?         @map("password_hash")
  passwordUpdatedAt DateTime?       @map("password_updated_at") @db.Timestamptz(6)
  name              String?
  avatarUrl         String?         @map("avatar_url")
  languageCode      String          @default("fa") @map("language_code")
  /// IANA timezone. Drives every "what day is it for this user" calculation.
  timezone          String          @default("Asia/Tehran")
  /// Hour (0-23, local) at which the user's day rolls over. Night owls set 4.
  dayStartHour      Int             @default(0) @map("day_start_hour")
  theme             ThemePreference @default(DARK)
  points            Int             @default(0)
  isPremium         Boolean         @default(false) @map("is_premium")
  ambientEnabled    Boolean         @default(true) @map("ambient_enabled")
  hapticsEnabled    Boolean         @default(true) @map("haptics_enabled")
  /// Which home widgets are visible, and in what order: `{ "visible": [...] }`.
  /// Null means "never customised", which is how the default layout can change
  /// later without every existing account being pinned to today's version —
  /// and how an empty list stays a real choice rather than a sentinel.
  homeWidgets       Json?           @map("home_widgets")
  notifyAtHour      Int             @default(8) @map("notify_at_hour")
  notifyAtMinute    Int             @default(0) @map("notify_at_minute")
  /// Anchors the 365-day curriculum; set on first sign-in.
  enrolledAt        DateTime        @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  onboardedAt       DateTime?       @map("onboarded_at") @db.Timestamptz(6)
  lastSeenAt        DateTime?       @map("last_seen_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tasks             Task[]
  habits            Habit[]
  habitLogs         HabitLog[]
  financialBoxes    FinancialBox[]
  transactions      FinancialTransaction[]
  countdownEvents   CountdownEvent[]
  notes             Note[]
  readingLogs       UserReadingLog[]
  pomodoroSessions  PomodoroSession[]
  refreshTokens     RefreshToken[]
  pushSubscriptions PushSubscription[]
  taskCategories    TaskCategory[]
  taskChecklist     TaskChecklistItem[]
  taskAttachments   TaskAttachment[]
  languageCourses   LanguageCourse[]
  vocabDeliveries   VocabularyDelivery[]
  vocabMastery      VocabularyMastery[]
  notificationPrefs NotificationPreference[]
  notificationLogs  NotificationLog[]
  readingPlan       ReadingPlan?
  books             UserBook[]
  readingSessions   ReadingSession[]

  @@index([phone])
  @@map("users")
}

/// One in-flight SMS challenge. Rows are single-use and expire in minutes; a
/// sweep in the nightly cron deletes what verification did not consume.
model OtpSession {
  id          String     @id @default(uuid()) @db.Uuid
  /// E.164 phone the code was sent to. Not a foreign key: a first-time sign-in
  /// has no user row yet.
  phone       String     @db.VarChar(16)
  purpose     OtpPurpose @default(SIGN_IN)
  /// HMAC-SHA256(pepper, `${phone}:${code}`) — never the code itself.
  codeHash    String     @map("code_hash") @db.VarChar(64)
  /// Opaque handle returned to the client so the verify call names one specific
  /// challenge instead of "the newest code for this number".
  challengeId String     @unique @map("challenge_id") @db.VarChar(64)
  attempts    Int        @default(0)
  /// Set once the attempt budget is spent; blocks verification until it passes.
  lockedUntil DateTime?  @map("locked_until") @db.Timestamptz(6)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(6)
  /// SHA-256 of the requesting IP. Enough to correlate abuse, not enough to
  /// rebuild a browsing history from a database dump.
  ipHash      String?    @map("ip_hash") @db.VarChar(64)
  userAgent   String?    @map("user_agent")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque token. The plaintext never touches the database.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userAgent String?   @map("user_agent")
  /// Set when the token is exchanged; a second use of a rotated token is
  /// treated as theft and revokes the whole family.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

/// A browser push endpoint. One row per installed TWA / browser profile.
model PushSubscription {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  endpoint  String    @unique
  /// Base64url P-256 public key of the user agent (RFC 8291 `p256dh`).
  p256dh    String
  /// Base64url 16-byte shared authentication secret (RFC 8291 `auth`).
  auth      String
  userAgent String?   @map("user_agent")
  /// Cleared on every successful delivery; a 404/410 from the push service
  /// deletes the row outright.
  failedAt  DateTime? @map("failed_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  title              String
  description        String?
  /// Absolute instant of the due date, stored in UTC.
  dueAt              DateTime?      @map("due_at") @db.Timestamptz(6)
  /// Denormalised Jalali day key ("1403-06-24") in the user's timezone, so the
  /// "today" query is a plain index lookup instead of a per-row TZ conversion.
  dueJalali          String?        @map("due_jalali") @db.VarChar(10)
  /// 1 = critical … 4 = someday. Mirrors the Eisenhower colour ramp in the UI.
  priority           Int            @default(3)
  difficulty         TaskDifficulty @default(MEDIUM)
  status             TaskStatus     @default(PENDING)
  /// RFC 5545 RRULE subset — see `src/lib/domain/recurrence.ts`.
  recurrence         String?
  estimatedPomodoros Int?           @map("estimated_pomodoros")
  tags               String[]       @default([])
  position           Int            @default(0)
  /// Money the task is expected to cost, in Toman. Optional, and deliberately
  /// on the task rather than in the finance module: "buy a present" is one
  /// thought, not a task plus a separate expense to remember to record.
  costAmount         Decimal?       @map("cost_amount") @db.Decimal(14, 0)
  /// Free text — "دفتر کار", "تهران", "خانهٔ مادر". Not geocoded: a place is a
  /// reminder to the person, not a coordinate for the app.
  location           String?        @db.VarChar(120)
  /// When to fire the reminder. Null means the due date carries no alarm.
  remindAt           DateTime?      @map("remind_at") @db.Timestamptz(6)
  categoryId         String?        @map("category_id") @db.Uuid
  completedAt        DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         TaskCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  checklist        TaskChecklistItem[]
  attachments      TaskAttachment[]
  pomodoroSessions PomodoroSession[]

  @@index([userId, dueJalali])
  @@index([userId, status, priority])
  @@index([userId, remindAt])
  @@map("tasks")
}

/// A user-owned, colour-coded label for tasks.
///
/// Its own table rather than a string on the task, because the brief asks for
/// renaming and recolouring: doing that to a string means rewriting every row
/// that happens to carry it, and missing the ones that were misspelled.
model TaskCategory {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  title      String   @db.VarChar(40)
  colorToken String   @default("violet") @map("color_token")
  icon       String?
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, title])
  @@index([userId, position])
  @@map("task_categories")
}

/// One line of a task's sub-task checklist.
model TaskChecklistItem {
  id          String    @id @default(uuid()) @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  /// Denormalised so RLS can scope the row without joining `tasks`.
  userId      String    @map("user_id") @db.Uuid
  title       String    @db.VarChar(200)
  position    Int       @default(0)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
  @@map("task_checklist_items")
}

/// A file attached to a task, stored in Supabase Storage.
///
/// Mirrors the note attachment layer: the row holds the object path and the
/// application mints a short-lived signed URL on demand. The bytes never pass
/// through the database.
model TaskAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// `<user-uuid>/<task-uuid>/<filename>` inside the attachments bucket.
  objectPath String   @unique @map("object_path")
  fileName   String   @map("file_name") @db.VarChar(200)
  mimeType   String   @map("mime_type") @db.VarChar(120)
  sizeBytes  Int      @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

// ---------------------------------------------------------------------------
// Habits
// ---------------------------------------------------------------------------

model Habit {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  title            String
  description      String?
  icon             String    @default("sparkles")
  colorToken       String    @default("flame") @map("color_token")
  /// Jalali weekday indices the habit is due on: 0 = شنبه … 6 = جمعه.
  frequency        Int[]     @default([0, 1, 2, 3, 4, 5, 6])
  targetPerDay     Int       @default(1) @map("target_per_day")
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  /// Missed days forgiven before the streak breaks ("streak freeze").
  graceDaysAllowed Int       @default(1) @map("grace_days_allowed")
  graceDaysUsed    Int       @default(0) @map("grace_days_used")
  /// Last scheduled day (UTC date key) on which the target was met.
  lastCompletedOn  DateTime? @map("last_completed_on") @db.Date
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId, archivedAt])
  @@map("habits")
}

model HabitLog {
  id        String   @id @default(uuid()) @db.Uuid
  habitId   String   @map("habit_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Calendar day in the user's timezone, normalised to a UTC midnight key.
  logDate   DateTime @map("log_date") @db.Date
  count     Int      @default(1)
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, logDate])
  @@index([userId, logDate])
  @@map("habit_logs")
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model FinancialBox {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  title         String
  description   String?
  /// Exact decimal arithmetic: Toman amounts run to ten digits and a float
  /// would start rounding a savings balance.
  targetAmount  Decimal              @map("target_amount") @db.Decimal(18, 2)
  currentAmount Decimal              @default(0) @map("current_amount") @db.Decimal(18, 2)
  currency      String               @default("IRT") @db.VarChar(3)
  category      FinancialBoxCategory @default(SAVINGS)
  colorToken    String               @default("emerald") @map("color_token")
  icon          String               @default("piggy-bank")
  deadlineAt    DateTime?            @map("deadline_at") @db.Timestamptz(6)
  archivedAt    DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]

  @@index([userId, archivedAt])
  @@map("financial_boxes")
}

model FinancialTransaction {
  id         String          @id @default(uuid()) @db.Uuid
  boxId      String          @map("box_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  /// Always positive; direction is carried by `type`.
  amount     Decimal         @db.Decimal(18, 2)
  type       TransactionType
  note       String?
  occurredAt DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  box  FinancialBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([boxId, occurredAt])
  @@map("financial_transactions")
}

// ---------------------------------------------------------------------------
// Countdowns & notes
// ---------------------------------------------------------------------------

model CountdownEvent {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  title               String
  description         String?
  eventAt             DateTime @map("event_at") @db.Timestamptz(6)
  /// Denormalised Jalali day key of `event_at`, for the timeline grouping.
  eventJalali         String?  @map("event_jalali") @db.VarChar(10)
  isAllDay            Boolean  @default(false) @map("is_all_day")
  colorToken          String   @default("violet") @map("color_token")
  icon                String   @default("calendar-heart")
  notifyBeforeMinutes Int[]    @default([1440, 60]) @map("notify_before_minutes")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventAt])
  @@map("countdown_events")
}

model Note {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  /// Markdown. Sanitised on render, never trusted on read.
  body        String   @default("")
  isPinned    Boolean  @default(false) @map("is_pinned")
  wordCount   Int      @default(0) @map("word_count")
  colorToken  String   @default("violet") @map("color_token")
  tags        String[] @default([])
  /// Supabase Storage object paths; served through short-lived signed URLs.
  attachments String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPinned, updatedAt])
  @@map("notes")
}

// ---------------------------------------------------------------------------
// 365 micro-book library
// ---------------------------------------------------------------------------

/// Global, read-only curriculum. Not tenant-scoped: RLS grants SELECT to every
/// scoped session and writes to the migration role only.
model Book365 {
  id               String   @id @default(uuid()) @db.Uuid
  dayNumber        Int      @unique @map("day_number")
  title            String
  titleFa          String   @map("title_fa")
  author           String
  authorFa         String   @map("author_fa")
  category         String
  coverUrl         String?  @map("cover_url")
  /// Persian micro-summary rendered on the daily card (markdown).
  summaryFa        String   @map("summary_fa")
  keyTakeaways     String[] @default([]) @map("key_takeaways")
  reflectionPrompt String   @map("reflection_prompt")
  readingMinutes   Int      @default(4) @map("reading_minutes")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  readingLogs UserReadingLog[]

  @@index([dayNumber])
  @@map("books_365")
}

model UserReadingLog {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  bookId     String    @map("book_id") @db.Uuid
  dayNumber  Int       @map("day_number")
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  /// The user's own micro-reflection, markdown, max 2000 chars.
  reflection String?
  highlights String[]  @default([])
  rating     Int?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book365 @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, dayNumber])
  @@map("user_reading_logs")
}

/// --------------------------------------------------------------------------
/// Reading Hub
/// --------------------------------------------------------------------------

/// One row per account: how long they read for, and which mode they are in.
///
/// Separate from `User` rather than two more columns on it because the pair is
/// only ever read together, only by the library, and a person who never opens
/// the Reading Hub should not carry its defaults as if they had chosen them.
model ReadingPlan {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @unique @map("user_id") @db.Uuid
  mode         ReadingMode @default(SUMMARY)
  /// The daily commitment in minutes. Constrained to 15, 30 or 60 — see
  /// `src/lib/domain/reading-plan.ts` for why it is a choice of three.
  dailyMinutes Int         @default(15) @map("daily_minutes")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reading_plans")
}

/// A book the person is reading themselves, tracked by page.
///
/// Pages rather than percent: a reader knows what page they stopped on, and
/// asking them to estimate a percentage is asking them to do arithmetic to
/// record something they already know exactly.
model UserBook {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String    @db.VarChar(200)
  author      String?   @db.VarChar(160)
  totalPages  Int       @map("total_pages")
  currentPage Int       @default(0) @map("current_page")
  /// A palette token, so a shelf of books is distinguishable at a glance
  /// without anybody having to find a cover image.
  colorToken  String    @default("violet") @map("color_token") @db.VarChar(20)
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions ReadingSession[]

  @@index([userId, finishedAt])
  @@map("user_books")
}

/// Minutes read on one day.
///
/// `bookId` is null for a session logged against the 365 curriculum, which is
/// what lets one streak and one "minutes today" ring serve both modes: the
/// question "did I read today" has the same answer whichever half answered it.
model ReadingSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookId    String?  @map("book_id") @db.Uuid
  /// Jalali day key ("1403-06-24") in the reader's timezone, so "today" is a
  /// plain index lookup rather than a per-row timezone conversion.
  dayKey    String   @map("day_key") @db.VarChar(10)
  minutes   Int
  /// Pages covered in this sitting. Zero in summary mode.
  pagesRead Int      @default(0) @map("pages_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book UserBook? @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([userId, dayKey])
  @@index([bookId])
  @@map("reading_sessions")
}

// ---------------------------------------------------------------------------
// Focus
// ---------------------------------------------------------------------------

model PomodoroSession {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  taskId          String?      @map("task_id") @db.Uuid
  mode            PomodoroMode @default(FOCUS)
  durationSeconds Int          @map("duration_seconds")
  startedAt       DateTime     @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?    @map("ended_at") @db.Timestamptz(6)
  completed       Boolean      @default(false)
  ambientTrack    String?      @map("ambient_track")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@map("pomodoro_sessions")
}

// ---------------------------------------------------------------------------
// Daily vocabulary
// ---------------------------------------------------------------------------

/// The shared word corpus: global reference data, like `Book365`.
///
/// One row per (language, level, term). Nothing here belongs to a user, which
/// is what lets ten learners receive the same word on the same day without ten
/// copies of it, and what makes the corpus editable in one place.
model VocabularyWord {
  id              String           @id @default(uuid()) @db.Uuid
  language        LearningLanguage
  level           LearningLevel
  /// The word as written in the target language.
  term            String           @db.VarChar(80)
  /// Latin transliteration, for scripts a Persian reader cannot sound out.
  transliteration String?          @map("transliteration") @db.VarChar(120)
  /// Persian meaning. The whole module exists to get from `term` to this.
  meaningFa       String           @map("meaning_fa") @db.VarChar(200)
  partOfSpeech    String?          @map("part_of_speech") @db.VarChar(40)
  /// One sentence using the word, and its Persian rendering.
  example         String?          @db.VarChar(300)
  exampleFa       String?          @map("example_fa") @db.VarChar(300)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  deliveries VocabularyDelivery[]
  mastery    VocabularyMastery[]

  @@unique([language, level, term])
  @@index([language, level])
  @@map("vocabulary_words")
}

/// One language a user is actively learning, at one level.
///
/// The brief allows one to three at a time; that ceiling is enforced in the
/// application rather than the schema, because "three" is a product decision
/// and a unique index cannot express it without inventing a slot number.
model LanguageCourse {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  language    LearningLanguage
  level       LearningLevel    @default(BEGINNER)
  /// How many new words a day. Ten is the brief's default and the cap.
  wordsPerDay Int              @default(10) @map("words_per_day")
  archivedAt  DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries VocabularyDelivery[]

  @@unique([userId, language])
  @@index([userId, archivedAt])
  @@map("language_courses")
}

/// A word handed to a learner on a particular day.
///
/// Persisted rather than recomputed so that yesterday's ten words stay
/// yesterday's ten words after the corpus grows — the selection is
/// deterministic, but determinism over a changing corpus is not stability.
model VocabularyDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  wordId    String   @map("word_id") @db.Uuid
  /// Jalali day key in the learner's timezone, e.g. "1405-06-26".
  dayKey    String   @map("day_key") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course LanguageCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  word   VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([courseId, dayKey, wordId])
  @@index([userId, dayKey])
  @@map("vocabulary_deliveries")
}

/// What a learner knows, and how well.
///
/// Separate from the delivery because they answer different questions: a
/// delivery is "what did you see on Tuesday", mastery is "do you know it now".
model VocabularyMastery {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  wordId         String           @map("word_id") @db.Uuid
  status         VocabularyStatus @default(LEARNING)
  /// Consecutive correct reviews. Drives the flashcard scheduler.
  correctRuns    Int              @default(0) @map("correct_runs")
  reviewCount    Int              @default(0) @map("review_count")
  lastReviewedAt DateTime?        @map("last_reviewed_at") @db.Timestamptz(6)
  masteredAt     DateTime?        @map("mastered_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, status])
  @@map("vocabulary_mastery")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

/// One switch per category per user.
///
/// A row exists only once the user has expressed a preference; the absence of
/// one means "the default for this category", which keeps a new account from
/// needing six inserts before it can be notified about anything.
model NotificationPreference {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  enabled   Boolean              @default(true)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

/// Everything the app has told this user, newest first.
///
/// `deepLink` is an in-app path rather than a record id, so the history keeps
/// working when the thing it points at is deleted: a 404 inside the app is a
/// better outcome than a tap that does nothing.
model NotificationLog {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  title     String               @db.VarChar(120)
  body      String               @db.VarChar(400)
  /// e.g. "/tasks?task=<uuid>" or "/tools/vocabulary".
  deepLink  String?              @map("deep_link") @db.VarChar(300)
  readAt    DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notification_logs")
}
