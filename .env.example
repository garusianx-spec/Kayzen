# ---------------------------------------------------------------------------
# Kayzen — environment contract. Copy to `.env.local` and fill in.
# Every server variable below is parsed and validated at boot by `src/lib/env.ts`.
#
# A variable left blank (`NAME=`) counts as absent, not as an empty value, so an
# optional one you are not using costs nothing. Only DATABASE_URL is genuinely
# required for local development; see the notes on each section.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# Pooled connection (PgBouncer, port 6543) used by the app at runtime. It MUST
# authenticate as `kayzen_app` — a NOBYPASSRLS role — or RLS is skipped.
DATABASE_URL="postgresql://kayzen_app:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct owner connection (port 5432). The running app never uses it, but the
# Prisma CLI (`db:push`, `db:migrate`) reads it from `schema.prisma` and fails
# without it — against a local Postgres, set it to the same value as above.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Supabase Storage -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Signs the short-lived URLs handed out for note attachments.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="kayzen-attachments"

# --- Auth: JWT sessions -----------------------------------------------------
# 32+ bytes of entropy: `openssl rand -base64 48`
# Under `next dev` this and AUTH_OTP_PEPPER fall back to throwaway values when
# unset, so a fresh clone can sign in with only DATABASE_URL configured. The
# fallback is announced on stdout at startup and never applies to a build.
AUTH_JWT_SECRET=""
AUTH_JWT_ISSUER="kayzen"
AUTH_JWT_AUDIENCE="kayzen-app"
AUTH_ACCESS_TOKEN_TTL_SECONDS="900"
AUTH_REFRESH_TOKEN_TTL_SECONDS="2592000"

# --- Auth: SMS OTP ----------------------------------------------------------
# Separate HMAC key for OTP digests. Rotating it invalidates in-flight codes
# only — sessions are unaffected. `openssl rand -base64 48`
AUTH_OTP_PEPPER=""
AUTH_OTP_LENGTH="6"
AUTH_OTP_TTL_SECONDS="120"
AUTH_OTP_MAX_ATTEMPTS="5"
# Cooldown applied after AUTH_OTP_MAX_ATTEMPTS wrong codes.
AUTH_OTP_LOCK_SECONDS="900"
# Minimum gap between two SMS to the same number (also enforced per IP).
AUTH_OTP_RESEND_SECONDS="120"
AUTH_OTP_DAILY_SEND_LIMIT="5"

# Local development only. When set, every challenge is issued with this exact
# code instead of a random one, so signing in locally needs no SMS gateway and
# no reading of the server log. Must be digits and exactly AUTH_OTP_LENGTH long.
# `src/lib/env.ts` refuses to start with this set when NODE_ENV=production.
# Nothing else changes: the code is still hashed, bound to the phone, rate
# limited, single-use and expiring, so the path you test is the real one.
AUTH_DEV_OTP_CODE="111111"
# Iterating on the sign-in screen? The send limits are real in development too,
# and AUTH_OTP_RESEND_SECONDS governs the per-IP window as well as the per-phone
# one — so a second attempt from your machine is refused within the cooldown
# even from a different number. 30 is the schema minimum for both:
#   AUTH_OTP_RESEND_SECONDS="30"
#   AUTH_OTP_TTL_SECONDS="30"

# --- SMS gateway ------------------------------------------------------------
# One of: console | kavenegar | farazsms | twilio
# `console` prints the code to the server log and sends nothing — dev only, and
# refused in production by `src/lib/env.ts`.
# Naming a gateway whose credentials are blank is a startup failure in
# production; outside it, the code falls back to `console` with a warning, so
# half-finished gateway setup never blocks local sign-in.
SMS_PROVIDER="console"

# Kavenegar (https://kavenegar.com) — verification lookup API.
KAVENEGAR_API_KEY=""
KAVENEGAR_TEMPLATE="kayzen-otp"
KAVENEGAR_SENDER=""

# FarazSMS / IPPanel (https://ippanel.com) — pattern API.
FARAZSMS_API_KEY=""
FARAZSMS_PATTERN_CODE=""
FARAZSMS_ORIGINATOR=""

# Twilio — plain SMS body, used for +98 numbers only as a fallback route.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Rate limiting / cache (Upstash Redis) ---------------------------------
# Required in production: the in-process fallback limiter does not hold across
# serverless instances. Leave these out entirely for local development — the
# limiter falls back to an in-process window and says so at startup.
# UPSTASH_REDIS_REST_URL="https://<name>.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

# --- Web Push (VAPID) -------------------------------------------------------
# Generate with `npm run vapid:generate`.
VAPID_SUBJECT="mailto:ops@kayzen.app"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Scheduled workers ------------------------------------------------------
# Presented by Vercel Cron / Upstash QStash as `Authorization: Bearer <secret>`.
CRON_SECRET=""

# --- Android TWA / Digital Asset Links -------------------------------------
# Package name declared in the Bubblewrap project.
ANDROID_PACKAGE_NAME="app.kayzen.twa"
# SHA-256 fingerprints of every signing certificate that may open the app
# without browser chrome. Comma-separated; include BOTH the upload key and the
# Play App Signing key, otherwise the URL bar reappears on Play-installed builds.
#   keytool -list -v -keystore android/kayzen.keystore -alias kayzen
ANDROID_SHA256_CERT_FINGERPRINTS=""

# --- Observability ----------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
LOG_LEVEL="info"

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Kayzen"
NODE_ENV="development"
