# ---------------------------------------------------------------------------
# Kayzen — environment contract. Copy to `.env.local` and fill in.
# Every server variable below is parsed and validated at boot by `src/lib/env.ts`.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# Pooled connection (PgBouncer, port 6543) used by the app at runtime. It MUST
# authenticate as `kayzen_app` — a NOBYPASSRLS role — or RLS is skipped.
DATABASE_URL="postgresql://kayzen_app:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct owner connection (port 5432) used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Supabase Storage -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Signs the short-lived URLs handed out for note attachments.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="kayzen-attachments"

# --- Auth: JWT sessions -----------------------------------------------------
# 32+ bytes of entropy: `openssl rand -base64 48`
AUTH_JWT_SECRET=""
AUTH_JWT_ISSUER="kayzen"
AUTH_JWT_AUDIENCE="kayzen-app"
AUTH_ACCESS_TOKEN_TTL_SECONDS="900"
AUTH_REFRESH_TOKEN_TTL_SECONDS="2592000"

# --- Auth: SMS OTP ----------------------------------------------------------
# Separate HMAC key for OTP digests. Rotating it invalidates in-flight codes
# only — sessions are unaffected. `openssl rand -base64 48`
AUTH_OTP_PEPPER=""
AUTH_OTP_LENGTH="6"
AUTH_OTP_TTL_SECONDS="120"
AUTH_OTP_MAX_ATTEMPTS="5"
# Cooldown applied after AUTH_OTP_MAX_ATTEMPTS wrong codes.
AUTH_OTP_LOCK_SECONDS="900"
# Minimum gap between two SMS to the same number (also enforced per IP).
AUTH_OTP_RESEND_SECONDS="120"
AUTH_OTP_DAILY_SEND_LIMIT="5"

# --- SMS gateway ------------------------------------------------------------
# One of: console | kavenegar | farazsms | twilio
# `console` prints the code to the server log and sends nothing — dev only, and
# refused in production by `src/lib/env.ts`.
SMS_PROVIDER="console"

# Kavenegar (https://kavenegar.com) — verification lookup API.
KAVENEGAR_API_KEY=""
KAVENEGAR_TEMPLATE="kayzen-otp"
KAVENEGAR_SENDER=""

# FarazSMS / IPPanel (https://ippanel.com) — pattern API.
FARAZSMS_API_KEY=""
FARAZSMS_PATTERN_CODE=""
FARAZSMS_ORIGINATOR=""

# Twilio — plain SMS body, used for +98 numbers only as a fallback route.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Rate limiting / cache (Upstash Redis) ---------------------------------
# Required in production: the in-process fallback limiter does not hold across
# serverless instances.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Web Push (VAPID) -------------------------------------------------------
# Generate with `npm run vapid:generate`.
VAPID_SUBJECT="mailto:ops@kayzen.app"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Scheduled workers ------------------------------------------------------
# Presented by Vercel Cron / Upstash QStash as `Authorization: Bearer <secret>`.
CRON_SECRET=""

# --- Android TWA / Digital Asset Links -------------------------------------
# Package name declared in the Bubblewrap project.
ANDROID_PACKAGE_NAME="app.kayzen.twa"
# SHA-256 fingerprints of every signing certificate that may open the app
# without browser chrome. Comma-separated; include BOTH the upload key and the
# Play App Signing key, otherwise the URL bar reappears on Play-installed builds.
#   keytool -list -v -keystore android/kayzen.keystore -alias kayzen
ANDROID_SHA256_CERT_FINGERPRINTS=""

# --- Observability ----------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
LOG_LEVEL="info"

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Kayzen"
NODE_ENV="development"
